        "operation": "executeQuery",
        "query": "-- The delivery row holds the original payload, so the failure can be replayed.\nINSERT INTO dead_letters (stage, delivery_id, execution_id, error)\nVALUES ('workflow',\n        (SELECT id FROM alert_deliveries WHERE execution_id = $1::text ORDER BY id DESC LIMIT 1),\n        $1::text, $2::text)\nRETURNING id AS dead_letter_id, delivery_id",
        "options": {
          "queryReplacement": "={{ [ String($json.execution.id), ($json.execution.lastNodeExecuted || 'unknown node') + ': ' + (($json.execution.error && $json.execution.error.message) || 'unknown error') ] }}"
        }
      },
      "name": "Record workflow failure",
