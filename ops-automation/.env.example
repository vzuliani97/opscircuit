# Copy to .env, or run `make env` to generate random values. .env is ignored by git.
# Values must be hex or other JSON-safe characters: n8n/import.sh writes them into a JSON credential file.
POSTGRES_PASSWORD=change-me
N8N_DB_PASSWORD=change-me
INCIDENTS_DB_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me
ALERT_WEBHOOK_TOKEN=change-me
